local function buildFeatures()
    local F = {}

    F["ESP Wendigo"] = {
        active = false, connections = {}, objects = {},
        start = function(self)
            self.active = true
            local lp = Players.LocalPlayer
            local function getRoot(m)
                if not m then return nil end
                local r = m:FindFirstChild("HumanoidRootPart")
                if r then return r end
                local h = m:FindFirstChild("Head")
                if h then return h end
                for _, c in m:GetChildren() do if c:IsA("BasePart") then return c end end
                return nil
            end
            local function applyESP(model)
                if not model or not model.Parent or model:FindFirstChild("Z3U5_WB") then return end
                local root = getRoot(model)
                if not root then model.DescendantAdded:Wait(); root = getRoot(model); end
                if not root then return end
                local bb = new("BillboardGui", model, {Name = "Z3U5_WB", Adornee = root, Size = UDim2.fromOffset(200, 50), StudsOffset = Vector3.new(0, 3, 0), AlwaysOnTop = true})
                new("TextLabel", bb, {Name = "N", Size = UDim2.fromScale(1, 0.5), BackgroundTransparency = 1, Text = "Wendigo", TextColor3 = Color3.fromRGB(255, 80, 80), Font = Enum.Font.GothamBold, TextSize = 14, TextStrokeTransparency = 0.5})
                new("TextLabel", bb, {Name = "D", Size = UDim2.fromScale(1, 0.5), Position = UDim2.fromScale(0, 0.5), BackgroundTransparency = 1, Text = "--m", TextColor3 = Color3.fromRGB(255, 150, 150), Font = Enum.Font.Gotham, TextSize = 12, TextStrokeTransparency = 0.5})
                table.insert(self.objects, bb)
                table.insert(self.objects, new("Highlight", model, {Name = "Z3U5_WH", FillColor = Color3.fromRGB(255, 30, 30), OutlineColor = Color3.fromRGB(255, 100, 100), FillTransparency = 0.4, OutlineTransparency = 0}))
            end
            local function navPath(p)
                local parts = p:split(".")
                local cur = workspace
                for i, n in ipairs(parts) do
                    local c = cur:FindFirstChild(n)
                    if c then
                        if i == #parts then return c, cur end
                        cur = c
                    else return nil, cur end
                end
                return nil, cur
            end
            local function watchWendigo(par)
                local e = par:FindFirstChild("Wendigo")
                if e then task.spawn(applyESP, e) end
                table.insert(self.connections, par.ChildAdded:Connect(function(c)
                    if c.Name == "Wendigo" then task.spawn(applyESP, c) end
                end))
            end
            local PATH = "NPC.Enemy.Wendigo"
            local target, watchPar = navPath(PATH)
            if target then task.spawn(applyESP, target) end
            if watchPar and watchPar.Name ~= "Wendigo" then watchWendigo(watchPar) end
            local function watchRemove(model)
                table.insert(self.connections, model.AncestryChanged:Connect(function(_, np)
                    if not np then
                        for i = #self.objects, 1, -1 do
                            if self.objects[i].Parent and self.objects[i]:IsDescendantOf(model) then
                                self.objects[i]:Destroy()
                                table.remove(self.objects, i)
                            end
                        end
                        if self.active then
                            task.delay(0.5, function()
                                if not self.active then return end
                                local f, fp = navPath(PATH)
                                if f then task.spawn(applyESP, f)
                                elseif fp then watchWendigo(fp) end
                            end)
                        end
                    end
                end))
            end
            local cw = workspace:FindFirstChild("NPC") and workspace.NPC:FindFirstChild("Enemy") and workspace.NPC.Enemy:FindFirstChild("Wendigo")
            if cw then watchRemove(cw) end
            if workspace:FindFirstChild("NPC") and workspace.NPC:FindFirstChild("Enemy") then
                table.insert(self.connections, workspace.NPC.Enemy.ChildAdded:Connect(function(c)
                    if c.Name == "Wendigo" then watchRemove(c) end
                end))
            end
            if not workspace:FindFirstChild("NPC") then
                table.insert(self.connections, workspace.ChildAdded:Connect(function(c)
                    if c.Name == "NPC" then
                        task.spawn(function()
                            c:WaitForChild("Enemy", 10)
                            if c:FindFirstChild("Enemy") then watchWendigo(c.Enemy) end
                        end)
                    end
                end))
            elseif not workspace.NPC:FindFirstChild("Enemy") then
                table.insert(self.connections, workspace.ChildAdded:Connect(function(c)
                    if c.Name == "Enemy" then watchWendigo(c) end
                end))
            end
            table.insert(self.connections, RunService.Heartbeat:Connect(function()
                if not self.active then return end
                local lc = lp.Character
                if not lc then return end
                local lr = lc:FindFirstChild("HumanoidRootPart")
                if not lr then return end
                local w = workspace:FindFirstChild("NPC") and workspace.NPC:FindFirstChild("Enemy") and workspace.NPC.Enemy:FindFirstChild("Wendigo")
                if not w then return end
                local bb = w:FindFirstChild("Z3U5_WB")
                if not bb then return end
                local wr = getRoot(w)
                if not wr then return end
                local dl = bb:FindFirstChild("D")
                if dl then dl.Text = math.floor((lr.Position - wr.Position).Magnitude) .. "m" end
            end))
            print("[Z3U5] ESP Wendigo: ON")
        end,
        stop = function(self)
