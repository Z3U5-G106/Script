    F["ESP Player"] = {
        active = false, connections = {}, objects = {},
        start = function(self)
            self.active = true
            local lp = Players.LocalPlayer
            local function addBB(char, pname)
                if char:FindFirstChild("Z3U5_BB") then return end
                local head = char:FindFirstChild("Head")
                if not head then return end
                local bb = new("BillboardGui", char, {Name = "Z3U5_BB", Adornee = head, Size = UDim2.fromOffset(200, 50), StudsOffset = Vector3.new(0, 3, 0), AlwaysOnTop = true})
                new("TextLabel", bb, {Name = "N", Size = UDim2.fromScale(1, 0.5), BackgroundTransparency = 1, Text = pname, TextColor3 = Color3.fromRGB(255, 255, 255), Font = Enum.Font.GothamBold, TextSize = 14, TextStrokeTransparency = 0.5})
                new("TextLabel", bb, {Name = "D", Size = UDim2.fromScale(1, 0.5), Position = UDim2.fromScale(0, 0.5), BackgroundTransparency = 1, Text = "--m", TextColor3 = Color3.fromRGB(180, 200, 255), Font = Enum.Font.Gotham, TextSize = 12, TextStrokeTransparency = 0.5})
                table.insert(self.objects, bb)
            end
            local function onChar(char)
                local p = Players:GetPlayerFromCharacter(char)
                if not p or p == lp then return end
                char:WaitForChild("Head")
                addBB(char, p.Name)
            end
            for _, p in Players:GetPlayers() do
                if p ~= lp then
                    if p.Character then task.spawn(addBB, p.Character, p.Name) end
                    table.insert(self.connections, p.CharacterAdded:Connect(onChar))
                end
            end
            table.insert(self.connections, Players.PlayerAdded:Connect(function(p)
                if p ~= lp then table.insert(self.connections, p.CharacterAdded:Connect(onChar)) end
            end))
            table.insert(self.connections, RunService.Heartbeat:Connect(function()
                if not self.active then return end
                local lc = lp.Character
                if not lc then return end
                local lr = lc:FindFirstChild("HumanoidRootPart")
                if not lr then return end
                for _, p in Players:GetPlayers() do
                    if p ~= lp and p.Character then
                        local bb = p.Character:FindFirstChild("Z3U5_BB")
                        if bb then
                            local pr = p.Character:FindFirstChild("HumanoidRootPart")
                            if pr then
                                local dl = bb:FindFirstChild("D")
                                if dl then dl.Text = math.floor((lr.Position - pr.Position).Magnitude) .. "m" end
                            end
                        end
                    end
                end
                local cp = {}
                local cm = {}
                for _, p in Players:GetPlayers() do
                    if p ~= lp and p.Character then
                        cm[p.Character] = true
                        for _, pt in p.Character:GetDescendants() do
                            if pt:IsA("BasePart") then table.insert(cp, pt) end
                        end
                    end
                end
                local params = OverlapParams.new()
                params.FilterType = Enum.RaycastFilterType.Include
                params.FilterDescendantsInstances = cp
                params.MaxParts = 500
                local near = workspace:GetPartBoundsInRadius(lr.Position, 100, params)
                local inR = {}
                for _, pt in near do
                    local ch = pt:FindFirstAncestorOfClass("Model")
                    if ch and cm[ch] then inR[ch] = true end
                end
                for ch in cm do
                    local hl = ch:FindFirstChild("Z3U5_HL")
                    if inR[ch] then
                        if not hl then
                            hl = new("Highlight", ch, {Name = "Z3U5_HL", FillColor = Color3.fromRGB(0, 100, 255), OutlineColor = Color3.fromRGB(50, 150, 255), FillTransparency = 0.5, OutlineTransparency = 0})
                            table.insert(self.objects, hl)
                        end
                    else
                        if hl then
                            hl:Destroy()
                            for i = #self.objects, 1, -1 do
                                if self.objects[i] == hl then table.remove(self.objects, i); break end
                            end
                        end
                    end
                end
            end))
            print("[Z3U5] ESP Player: ON")
        end,
        stop = function(self)
            self.active = false
            for i = 1, #self.objects do if self.objects[i].Parent then self.objects[i]:Destroy() end end
            for i = 1, #self.connections do if self.connections[i] then self.connections[i]:Disconnect() end end
            self.objects = {}
            self.connections = {}
            print("[Z3U5] ESP Player: OFF")
        end
    }

