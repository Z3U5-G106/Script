    for name, feature in pairs(F) do
        if name == "Teleport" or name == "Other" then
            Z.toggleFunctions[name] = function()
                if feature.active then
                    feature:stop()
                else
                    feature:start()
                end
            end
        else
            Z.toggleFunctions[name] = function(state)
                if state then feature:start() else feature:stop() end
            end
        end
    end
