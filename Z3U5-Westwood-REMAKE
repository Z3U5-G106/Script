local function buildDrag()
    local btn = Z.toggleButton
    local panel = Z.panel
    local tp = Z.teleportPanel
    local op = Z.otherPanel
    local dragging = false
    local ds = Vector3.new()
    local ls = UDim2.new()
    local ps = UDim2.new()
    local ts = UDim2.new()
    local os = UDim2.new()

    function Z.sync()
        panel.Position = UDim2.new(btn.Position.X.Scale, btn.Position.X.Offset + (Z.BS / 2) - (Z.PW / 2), btn.Position.Y.Scale, btn.Position.Y.Offset + Z.BS + Z.PG)
        tp.Position = UDim2.new(panel.Position.X.Scale, panel.Position.X.Offset + Z.PW + Z.TG, panel.Position.Y.Scale, panel.Position.Y.Offset)
        op.Position = UDim2.new(panel.Position.X.Scale, panel.Position.X.Offset - Z.OW - Z.OG, panel.Position.Y.Scale, panel.Position.Y.Offset)
    end

    btn.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            ds = input.Position
            ls = btn.Position
            ps = panel.Position
            ts = tp.Position
            os = op.Position
            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then dragging = false end
            end)
        end
    end)

    btn.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then dragging = false end
    end)

    UserInputService.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            local dx = input.Position.X - ds.X
            local dy = input.Position.Y - ds.Y
            btn.Position = UDim2.new(ls.X.Scale, ls.X.Offset + dx, ls.Y.Scale, ls.Y.Offset + dy)
            panel.Position = UDim2.new(ps.X.Scale, ps.X.Offset + dx, ps.Y.Scale, ps.Y.Offset + dy)
            tp.Position = UDim2.new(ts.X.Scale, ts.X.Offset + dx, ts.Y.Scale, ts.Y.Offset + dy)
            op.Position = UDim2.new(os.X.Scale, os.X.Offset + dx, os.Y.Scale, os.Y.Offset + dy)
        end
    end)
end

local function buildOpenClose()
    local panel = Z.panel
    local tp = Z.teleportPanel
    local op = Z.otherPanel
    Z.panelVisible = false

    local function enableMouse()
        RunService:BindToRenderStep("Z3U5_FreeMouse", Enum.RenderPriority.Last.Value, function()
            UserInputService.MouseBehavior = Enum.MouseBehavior.Default
            UserInputService.MouseIconEnabled = true
        end)
    end

    local function disableMouse()
        RunService:UnbindFromRenderStep("Z3U5_FreeMouse")
        UserInputService.MouseBehavior = Enum.MouseBehavior.Default
    end

    local function open()
        panel.Visible = true
        Z.sync()
        enableMouse()
        panel.Size = UDim2.fromOffset(Z.PW, 0)
        TweenService:Create(panel, TweenInfo.new(Z.AS, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {Size = UDim2.fromOffset(Z.PW, Z.panelHeight)}):Play()
    end

    local function close()
        disableMouse()
        local t = TweenService:Create(panel, TweenInfo.new(Z.AS, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {Size = UDim2.fromOffset(Z.PW, 0)})
        t:Play()
        t.Completed:Connect(function()
            panel.Visible = false
            tp.Visible = false
            op.Visible = false
        end)
    end

    function Z.togglePanel()
        Z.panelVisible = not Z.panelVisible
        if Z.panelVisible then open() else close() end
    end

    local cs = Vector3.new()
    Z.toggleButton.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then cs = input.Position end
    end)
    Z.toggleButton.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            if (input.Position - cs).Magnitude < 5 then Z.togglePanel() end
        end
    end)

    UserInputService.InputBegan:Connect(function(input, gp)
        if not gp and input.KeyCode == Enum.KeyCode.Z then Z.togglePanel() end
    end)
end

