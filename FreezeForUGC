-- TOGGLE CLICK LOGIC
-- ==========================================
toggleBtn1.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        if math.abs((input.Position - dragStart).X) > 5 or math.abs((input.Position - dragStart).Y) > 5 then return end

        isChestEnabled = not isChestEnabled

        if isChestEnabled then
            TweenService:Create(toggleBtn1, TweenInfo.new(0.2), {BackgroundColor3 = Color3.fromRGB(0, 150, 0)}):Play()
            TweenService:Create(toggleCircle1, TweenInfo.new(0.2), {Position = UDim2.new(0, 22, 0.5, -8)}):Play()
            statusLabel1.TextColor3 = Color3.fromRGB(0, 255, 0)
            startChestLoop()
        else
            TweenService:Create(toggleBtn1, TweenInfo.new(0.2), {BackgroundColor3 = Color3.fromRGB(100, 100, 100)}):Play()
            TweenService:Create(toggleCircle1, TweenInfo.new(0.2), {Position = UDim2.new(0, 2, 0.5, -8)}):Play()
            statusLabel1.TextColor3 = Color3.fromRGB(200, 200, 200)
            stopChestLoop()
        end
    end
end)

toggleBtn2.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        if math.abs((input.Position - dragStart).X) > 5 or math.abs((input.Position - dragStart).Y) > 5 then return end

        isSpinEnabled = not isSpinEnabled

        if isSpinEnabled then
            TweenService:Create(toggleBtn2, TweenInfo.new(0.2), {BackgroundColor3 = Color3.fromRGB(0, 150, 0)}):Play()
            TweenService:Create(toggleCircle2, TweenInfo.new(0.2), {Position = UDim2.new(0, 22, 0.5, -8)}):Play()
            statusLabel2.TextColor3 = Color3.fromRGB(0, 255, 0)
