        else
            TweenService:Create(toggleBtn2, TweenInfo.new(0.2), {BackgroundColor3 = Color3.fromRGB(100, 100, 100)}):Play()
            TweenService:Create(toggleCircle2, TweenInfo.new(0.2), {Position = UDim2.new(0, 2, 0.5, -8)}):Play()
            statusLabel2.TextColor3 = Color3.fromRGB(200, 200, 200)
            stopSpinLoop()
        end
    end
end)

